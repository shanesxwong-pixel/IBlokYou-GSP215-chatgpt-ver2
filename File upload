              </div>

              {/* RIGHT COLUMN: 4 Player Cards + Live Feed + Host Shortcuts */}
              <div className="lg:col-span-5 flex flex-col gap-4">
                {/* 2x2 Grid of Player Cards */}
                <div className="grid grid-cols-2 gap-3.5">
                  {roomState.turnOrder.map((pid) => {
                    const p = roomState.players[pid];
                    const cfg = PLAYERS[pid];
                    const score = p?.score || 0;
                    const isActive = roomState.currentTurnPlayerId === pid;

                    return (
                      <PlayerCard
                        key={pid}
                        player={{
                          ...cfg,
                          name: p ? p.name : cfg.name,
                          politenessTokens: 3,
                        }}
                        score={score}
                        isActive={isActive}
                        hasConsensus={score >= 50}
                      />
                    );
                  })}
                </div>

                {/* Host Quick Toolbar */}
                {isHost && (
                  <div className="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
                    <div className="flex items-center justify-between text-xs font-bold text-slate-900 border-b border-slate-100 pb-2">
                      <div className="flex items-center gap-1.5">
                        <Shield className="w-4 h-4 text-purple-600" />
                        <span>Host Match Management</span>
                      </div>
                      <span className="text-[10px] font-mono text-slate-400">AUTHORITATIVE</span>
                    </div>

                    <div className="grid grid-cols-3 gap-2 text-xs">
                      {roomState.status === 'paused' ? (
                        <button
                          onClick={hostResume}
                          className="py-2 px-2.5 rounded-xl font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-300 transition-colors cursor-pointer flex items-center justify-center gap-1"
                        >
                          <Play className="w-3.5 h-3.5 fill-current" />
                          <span>Resume</span>
                        </button>
                      ) : (
                        <button
                          onClick={hostPause}
                          className="py-2 px-2.5 rounded-xl font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-300 transition-colors cursor-pointer flex items-center justify-center gap-1"
                        >
                          <Pause className="w-3.5 h-3.5 fill-current" />
                          <span>Pause</span>
                        </button>
                      )}

                      <button
                        onClick={() => setIsHostControlsOpen(true)}
                        className="py-2 px-2.5 rounded-xl font-bold bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 transition-colors cursor-pointer flex items-center justify-center gap-1"
                      >
                        <Sparkles className="w-3.5 h-3.5" />
                        <span>Extra Turn</span>
                      </button>

                      <button
                        onClick={() => setIsHistoryOpen(true)}
                        className="py-2 px-2.5 rounded-xl font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 transition-colors cursor-pointer flex items-center justify-center gap-1"
                      >
                        <span>Rollback</span>
                      </button>
                    </div>
                  </div>
                )}

                {/* Authoritative Live Action Feed (Latest 4 events) */}
                <div className="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
                  <div className="flex items-center justify-between text-xs font-bold text-slate-900 border-b border-slate-100 pb-2">
                    <div className="flex items-center gap-1.5">
                      <Clock className="w-4 h-4 text-blue-600" />
                      <span>Live Match Action Feed</span>
                    </div>
                    <button
                      onClick={() => setIsHistoryOpen(true)}
                      className="text-[11px] text-blue-600 hover:text-blue-800 font-bold cursor-pointer"
                    >
                      View All ({roomState.history.length})
                    </button>
                  </div>

                  <div className="space-y-2 text-xs">
                    {roomState.history.length === 0 ? (
                      <p className="text-slate-400 text-center py-4 text-xs">
                        Game started. No tile placements yet.
                      </p>
                    ) : (
                      [...roomState.history]
                        .reverse()
                        .slice(0, 4)
                        .map((evt) => (
                          <div
                            key={evt.sequence}
                            className="p-2.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start justify-between gap-2"
                          >
                            <div>
                              <div className="flex items-center gap-1.5 text-[11px] font-bold text-slate-900">
                                <span
                                  className="w-2 h-2 rounded-full"
                                  style={{
                                    backgroundColor:
                                      PLAYERS[evt.playerId]?.colorHex || '#64748b',
                                  }}
                                />
                                <span>{evt.playerName}</span>
                                <span className="text-[10px] font-mono text-slate-400 font-normal">
                                  #{evt.sequence}
                                </span>
                              </div>
                              <p className="text-slate-600 text-[11px] mt-0.5 leading-snug">
                                {evt.description}
                              </p>
                            </div>
                            <span
                              className={`text-[9px] font-bold uppercase px-1.5 py-0.5 rounded ${
                                evt.category === 'positive'
                                  ? 'bg-emerald-100 text-emerald-800'
                                  : evt.category === 'negative'
                                  ? 'bg-amber-100 text-amber-800'
                                  : 'bg-blue-100 text-blue-800'
                              }`}
                            >
                              {evt.category}
                            </span>
                          </div>
                        ))
                    )}
                  </div>
                </div>
              </div>
            </div>
          </>
        )}
      </main>

      {/* POPUP MODALS */}
      {/* 1. History Modal with Host Rollback */}
      {roomState && (
        <HistoryModal
          isOpen={isHistoryOpen}
          onClose={() => setIsHistoryOpen(false)}
          history={roomState.history}
          isHost={isHost}
          onRollback={(seq) => {
            hostRollback(seq);
            setIsHistoryOpen(false);
          }}
        />
      )}

      {/* 2. Host Command Controls Modal */}
      {roomState && isHost && (
        <HostControlsModal
          isOpen={isHostControlsOpen}
          onClose={() => setIsHostControlsOpen(false)}
          roomState={roomState}
          onPause={hostPause}
          onResume={hostResume}
          onGrantExtraTurn={hostGrantExtraTurn}
          onOpenHistory={() => setIsHistoryOpen(true)}
        />
      )}

      {/* 3. Simplified Direct Binary Swap Modal:
          [Tile Selected] -> [Select Target Player] -> [Play Swap Card] -> [A / B Prompt] -> [Show Legal Placements] */}
      {roomState && (
        <SwapModal
          isOpen={isSwapDialogOpen || Boolean(roomState.activeSwap)}
          onClose={() => {
            setIsSwapDialogOpen(false);
            if (roomState.activeSwap && roomState.activeSwap.initiatorId === yourPlayerId) {
              cancelSwap();
            }
          }}
          roomState={roomState}
          yourPlayerId={yourPlayerId}
          selectedTileId={selectedPieceId}
          activeSwap={roomState.activeSwap}
          onConfirmExchange={(targetPlayerId, offeredPieceId, requestedPieceId) => {
            proposeSwap(targetPlayerId, offeredPieceId, requestedPieceId);
            setIsSwapDialogOpen(false);
          }}
          onResolveActiveSwap={(isAccepted) => {
            if (isAccepted) {
              respondSwap('accept');
              // Automatically switch to the swapped tile so legal placements show immediately!
              if (roomState.activeSwap) {
                const acquiredPieceId =
                  yourPlayerId === roomState.activeSwap.recipientId
                    ? roomState.activeSwap.terms.offeredPieceId
                    : roomState.activeSwap.terms.requestedPieceId;
                setSelectedPieceId(acquiredPieceId);
                sound.playPowerCardShimmer();
              }
            } else {
              respondSwap('decline');
            }
          }}
        />
      )}

      {/* 4. New five-card deck. Swap and Force Keep use existing server actions; the other three are clearly marked as guide-only until their server mechanics are ported. */}
      <PowerCardsModal
        isOpen={isPowerCardsOpen}
        onClose={() => setIsPowerCardsOpen(false)}
        canUseSwap={Boolean(roomState && isYourTurn && !yourPlayer?.powerCards.swapUsed && roomState.settings.enableSwap)}
        canUseForceKeep={Boolean(roomState && isYourTurn && !yourPlayer?.powerCards.forceKeepUsed && roomState.settings.enableForceKeep)}
        onActivateCard={(cardId) => {
          if (!roomState || !yourPlayer) {
            setErrorMessage('Create or join a multiplayer room before activating a Power Card.');
            return;
          }
          if (!isYourTurn) {
            setErrorMessage('You can only activate a Power Card during your turn.');
            return;
          }
          if (cardId === 'swap') {
            setIsSwapDialogOpen(true);
          } else if (cardId === 'force-keep') {
            setForceKeepActive(true);
            setErrorMessage('Force Keep is active. Select an opponent-owned square on the board.');
          }
        }}
      />

      {/* 5. Complete Documentation Modal */}
      <DocumentationModal
        isOpen={isDocsOpen}
        onClose={() => setIsDocsOpen(false)}
        publicAppUrl={currentOrigin}
        version={VERSION_TAG}
      />
    </div>
  );
}

import React, { useState } from 'react';
import { PlayerId, RoomState, SwapProposal } from '../types/multiplayer';
import { PLAYERS } from '../data/storylineScript';
import { RAW_PIECES_DATA } from '../utils/pieces';
import { ArrowRightLeft, X, Check, AlertCircle } from 'lucide-react';

interface SwapModalProps {
  isOpen: boolean;
  onClose: () => void;
  roomState: RoomState;
  yourPlayerId: PlayerId | null;
  selectedTileId: string | null;
  activeSwap: SwapProposal | null;
  onConfirmExchange: (targetPlayerId: PlayerId, offeredPieceId: string, requestedPieceId: string) => void;
  onResolveActiveSwap: (isAccepted: boolean) => void;
}

export const SwapModal: React.FC<SwapModalProps> = ({
  isOpen,
  onClose,
  roomState,
  yourPlayerId,
  selectedTileId,
  activeSwap,
  onConfirmExchange,
  onResolveActiveSwap,
}) => {
  // Other connected players
  const otherPlayerIds = roomState.turnOrder.filter(
    (pid) => pid !== yourPlayerId && roomState.players[pid] !== null && roomState.players[pid]?.isConnected
  );

  const [targetPlayerId, setTargetPlayerId] = useState<PlayerId>(
    otherPlayerIds[0] || 'player2'
  );

  if (!isOpen && !activeSwap) return null;

  // CASE 1: If there's an incoming or active swap proposal from the server
  if (activeSwap) {
    const isRecipient = yourPlayerId === activeSwap.recipientId;
    const isInitiator = yourPlayerId === activeSwap.initiatorId;
    const playerA = roomState.players[activeSwap.initiatorId];
    const playerB = roomState.players[activeSwap.recipientId];

    const pieceA = RAW_PIECES_DATA.find((p) => p.id === activeSwap.terms.offeredPieceId);
    const pieceB = RAW_PIECES_DATA.find((p) => p.id === activeSwap.terms.requestedPieceId);

    const tileALabel = pieceA ? `${pieceA.name}` : 'Tile A';
    const tileBLabel = pieceB ? `${pieceB.name}` : 'Tile B';

    return (
      <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-fade-in text-slate-900">
        <div className="bg-white rounded-2xl shadow-2xl border-2 border-slate-900 w-full max-w-md p-6 text-center space-y-5">
          <div>
            <h3 className="text-xl font-black text-slate-900">
              Tile Exchange via Swap Card
            </h3>
            <p className="text-xs text-slate-600 mt-1">
              Trading between <strong>{playerA?.name || 'Player A'}</strong> and{' '}
              <strong>{playerB?.name || 'Player B'}</strong>
            </p>
          </div>

          {/* Clean Binary Conceptual Exchange Slots */}
          <div className="flex items-center justify-center gap-3 py-3">
            <div className="border-2 border-dashed border-slate-500 bg-slate-50 px-4 py-3 rounded-xl font-bold text-sm text-slate-900 shadow-xs">
              <span className="text-[10px] uppercase font-mono block text-slate-500 mb-0.5">
                {playerA?.name}
              </span>
              Tile A ({tileALabel})
            </div>

            <div className="text-2xl font-bold text-slate-400 select-none">⇄</div>

            <div className="border-2 border-dashed border-slate-500 bg-slate-50 px-4 py-3 rounded-xl font-bold text-sm text-slate-900 shadow-xs">
              <span className="text-[10px] uppercase font-mono block text-slate-500 mb-0.5">
                {playerB?.name}
              </span>
              Tile B ({tileBLabel})
            </div>
          </div>

          <p className="text-xs text-slate-500">
            {isRecipient
              ? 'ACTION REQUIRED: Do you accept or reject this tile exchange?'
              : isInitiator
              ? 'Awaiting response from negotiation partner...'
              : 'Processing interaction between players...'}
          </p>

          {/* Action Buttons */}
          <div className="flex items-center justify-center gap-3 pt-2">
            {isRecipient ? (
              <>
                <button
                  onClick={() => onResolveActiveSwap(true)}
                  className="px-6 py-2.5 rounded-xl font-bold text-sm bg-[#2ecc71] hover:bg-[#27ae60] text-white shadow-md transition-all active:scale-95 cursor-pointer"
                >
                  Confirm Exchange
                </button>
                <button
                  onClick={() => onResolveActiveSwap(false)}
                  className="px-6 py-2.5 rounded-xl font-bold text-sm bg-[#e74c3c] hover:bg-[#c0392b] text-white shadow-md transition-all active:scale-95 cursor-pointer"
                >
                  Reject Exchange
                </button>
              </>
            ) : isInitiator ? (
              <button
                onClick={() => onResolveActiveSwap(false)}
                className="px-5 py-2 rounded-xl text-xs font-bold bg-slate-200 hover:bg-slate-300 text-slate-700 cursor-pointer"
              >
                Cancel Exchange Request
              </button>
            ) : (
              <span className="text-xs text-slate-400 font-mono">Turn locked during swap</span>
            )}
          </div>
        </div>
      </div>
    );
  }

  // CASE 2: Initiating a New Swap
  const playerA = yourPlayerId ? roomState.players[yourPlayerId] : null;
  const playerB = roomState.players[targetPlayerId];

