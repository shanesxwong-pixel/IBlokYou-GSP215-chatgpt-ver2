/**
 * Types for the iBlokYou game, politeness token mechanics, and narrative simulation.
 */

export type PlayerId = 'player1' | 'player2' | 'player3' | 'player4';

export interface PlayerProfile {
  id: PlayerId;
  name: string;
  role: string; // "PERSECUTOR", "VICTIM", "RESCUER", "ALLY"
  colorName: string;
  colorHex: string;
  bgHex: string;
  borderHex: string;
  avatar: string;
  personality: string;
  playStyle: string;
  corner: [number, number]; // [row, col]
  politenessTokens: number; // starts at 3; deductions for unassertive or aggressive taunts
  faceSavingStrategyApplied?: boolean;
}

export type PolyominoShape = number[][]; // 2D matrix (1 for filled, 0 for empty)

export interface Piece {
  id: string;
  name: string;
  size: number; // number of squares (1 to 5)
  matrix: PolyominoShape;
  used: boolean;
}

export interface BoardCell {
  playerId: PlayerId | null;
  pieceId?: string;
  isConflictSpot?: boolean;
  isHighlighted?: boolean;
  placedAtStep?: number;
}

export type GameStage = 
  | 'setup'       // Scissors-Paper-Stone & player intros
  | 'round1'      // 0 to 30 points: The Spark of Conflict
  | 'round2'      // 30 to 50 points: Deepening Conflict & 3-Corner Power Cards
  | 'round3'      // 50+ points: Liam's Differential Strategy & Face-Saving Consensus
  | 'consensus';  // Victory reached! All players >= 50 points

export interface StoryDialogue {
  speakerId: PlayerId | 'narrator';
  speakerName: string;
  text: string;
  emotion: 'aggressive' | 'shy' | 'assertive' | 'cooperative' | 'neutral' | 'triumphant' | 'face-saving';
  highlightCells?: [number, number][];
  politenessNote?: string;
}

export interface ScriptedStep {
  stepIndex: number;
  stage: GameStage;
  stageTitle: string;
  playerId: PlayerId;
  pieceId: string;
  row: number;
  col: number;
  rotation: number; // 0, 90, 180, 270
  flipped: boolean;
  scoreAfter: Record<PlayerId, number>;
  narrativeNote?: string;
  dialogue?: StoryDialogue;
  isConflictTrigger?: boolean;
  isPowerCardEvent?: boolean;
  powerCardName?: 'Change Swap' | 'Force Keep' | 'Touch-Me-Not';
  timestampStr: string; // e.g. "02:40"
  politenessDelta?: { playerId: PlayerId; change: number; reason: string };
}

export interface PowerCard {
  id: 'change-swap' | 'force-keep' | 'touch-me-not';
  name: string;
  subtitle: string;
  description: string;
  usageCount: number;
  maxUsage: number;
  badge: string;
}

export interface PlaytestTimestamp {
  timestamp: string;
  stageName: string;
  description: string;
  category: 'setup' | 'choice' | 'conflict' | 'creator' | 'consensus';
}

/**
 * Multiplayer Data Contracts for iBlokYou Four-Player Online Game.
 */

import { BoardCell, Piece, PolyominoShape } from './game';

export type PlayerId = 'player1' | 'player2' | 'player3' | 'player4';

export interface HeldTile {
  id: string;
  originalPlayerId: PlayerId;
  pieceId: string;
  shape: PolyominoShape;
  size: number;
}

export interface RoomPlayer {
  id: PlayerId;
  sessionId: string;
  name: string;
  code: string; // e.g. "P1-8F3A"
  colorHex: string;
  colorName: string;
  role: string;
  corner: [number, number];
  isHost: boolean;
  isReady: boolean;
  isConnected: boolean;
  score: number;
  pieces: Piece[];
  heldTiles: HeldTile[];
  powerCards: {
    forceKeepUsed: boolean;
    swapUsed: boolean;
  };
  extraTurns: number;
}

export interface HostSettings {
  enableForceKeep: boolean;
  enableSwap: boolean;
  allowHostExtraTurns: boolean;
  enableTurnTimer: boolean;
  turnDurationSeconds: number;
  enableDetailedHistory: boolean;
}

export type SwapStatus =
  | 'pending'
  | 'accepted'
  | 'declined'
  | 'counter-offered'
  | 'completed'
  | 'cancelled';

export interface SwapTerms {
  offeredPieceId: string;
  requestedPieceId: string;
  offeredTileCoord?: [number, number];
  requestedTileCoord?: [number, number];
}

export interface SwapProposal {
  id: string;
  initiatorId: PlayerId;
  recipientId: PlayerId;
  terms: SwapTerms;
  status: SwapStatus;
  waitingForPlayerId: PlayerId;
  counterTerms?: SwapTerms;
  initiatorConfirmed: boolean;
  recipientConfirmed: boolean;
  turnLocked: boolean;
  createdAt: number;
  updatedAt: number;
}

export type HistoryCategory = 'positive' | 'negative' | 'neutral';

export interface HistoryEvent {
  sequence: number;
  timestamp: number;
  playerId: PlayerId;
  playerName: string;
  playerCode: string;
  eventType:
    | 'place_tile'
    | 'force_keep'
    | 'swap_propose'
    | 'swap_accept'
    | 'swap_decline'
    | 'swap_counter'
    | 'swap_complete'
    | 'swap_cancel'
    | 'host_extra_turn'
    | 'host_pause'
    | 'host_resume'
    | 'host_rollback'
    | 'player_reconnect'
    | 'turn_timeout'
    | 'game_start';
  category: HistoryCategory;
  description: string;
  details?: Record<string, unknown>;
  snapshotIndex?: number;
}

export interface GameSnapshot {
  sequence: number;
  board: BoardCell[][];
  scores: Record<PlayerId, number>;
  playerPieces: Record<PlayerId, Piece[]>;
  playerHeldTiles: Record<PlayerId, HeldTile[]>;
  powerCards: Record<PlayerId, { forceKeepUsed: boolean; swapUsed: boolean }>;
  currentTurnPlayerId: PlayerId;
  turnTimeRemaining: number;
}

export type GameStatus = 'lobby' | 'playing' | 'paused' | 'ended';

export interface RoomState {
  roomCode: string;
  status: GameStatus;
  hostSessionId: string;
  settings: HostSettings;
  players: Record<PlayerId, RoomPlayer | null>;
  turnOrder: PlayerId[];
  currentTurnPlayerId: PlayerId;
  board: BoardCell[][];
  turnTimeRemaining: number;
  isTimerPaused: boolean;
  activeSwap: SwapProposal | null;
  history: HistoryEvent[];
  snapshots: GameSnapshot[];
  winner: PlayerId | 'consensus' | null;
  round: number;
}

// Client -> Server Messages
export type ClientMessage =
  | { type: 'join_room'; roomCode: string; playerName: string; sessionId: string }
  | { type: 'create_room'; playerName: string; sessionId: string; settings?: Partial<HostSettings> }
  | { type: 'set_ready'; ready: boolean }
  | { type: 'update_settings'; settings: Partial<HostSettings> }
  | { type: 'start_game' }
  | { type: 'place_tile'; pieceId: string; shape: PolyominoShape; row: number; col: number; rotation: number; flipped: boolean }
  | { type: 'pass_turn' }
  | { type: 'force_keep'; targetRow: number; targetCol: number }
  | { type: 'place_held_tile'; heldTileId: string; row: number; col: number }
  | { type: 'swap_propose'; recipientId: PlayerId; offeredPieceId: string; requestedPieceId: string; offeredTileCoord?: [number, number]; requestedTileCoord?: [number, number] }
  | { type: 'swap_respond'; action: 'accept' | 'decline' | 'counter'; counterTerms?: SwapTerms }
  | { type: 'swap_confirm'; confirmed: boolean }
  | { type: 'swap_cancel' }
  | { type: 'host_grant_extra_turn'; toPlayerId: PlayerId; reason?: string }
  | { type: 'host_pause' }
  | { type: 'host_resume' }
  | { type: 'host_rollback'; eventSequence: number }
  | { type: 'ping' };

// Server -> Client Messages
export type ServerMessage =
  | { type: 'room_state'; state: RoomState; yourPlayerId: PlayerId | null; isHost: boolean }
  | { type: 'error'; message: string }
  | { type: 'toast'; message: string; toastType?: 'info' | 'success' | 'warning' | 'error' }
  | { type: 'pong' };

