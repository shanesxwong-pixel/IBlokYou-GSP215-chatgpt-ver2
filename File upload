                      setSelectedPieceId(id);
                      setSelectedHeldTileId(null);
                    }}
                    rotation={rotation}
                    flipped={flipped}
                    onRotate={() => {
                      setRotation((prev) => (prev + 90) % 360);
                      sound.playTileRotate();
                    }}
                    onFlip={() => {
                      setFlipped((prev) => !prev);
                      sound.playTileRotate();
