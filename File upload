    /* =========================================================================
       RECURSIVE FLOOD-FILL STRUCTURE CALCULATOR
       ========================================================================= */
    function floodFillBlock(startX, startY, targetOwner) {
        if (startX < 0 || startX >= BOARD_SIZE || startY < 0 || startY >= BOARD_SIZE) return [];
        if (gridData[startY][startX] !== targetOwner) return [];

        const visited = Array(BOARD_SIZE).fill(null).map(() => Array(BOARD_SIZE).fill(false));
        const block = [];
        const queue = [{ x: startX, y: startY }];
        visited[startY][startX] = true;

        while (queue.length > 0) {
            const { x, y } = queue.shift();
            block.push({ x, y });

            const neighbors = [
                { x: x + 1, y: y },
                { x: x - 1, y: y },
                { x: x, y: y + 1 },
                { x: x, y: y - 1 }
            ];

            for (const n of neighbors) {
                if (n.x >= 0 && n.x < BOARD_SIZE && n.y >= 0 && n.y < BOARD_SIZE) {
                    if (!visited[n.y][n.x] && gridData[n.y][n.x] === targetOwner) {
                        visited[n.y][n.x] = true;
                        queue.push(n);
                    }
                }
            }
        }
        return block;
    }

    /* =========================================================================
       MATHEMATICAL PLACEMENT VALIDATION (Blokus + Trust Immunity)
       ========================================================================= */
    function validatePlacement(matrix, startX, startY, player) {
        const rows = matrix.length;
        const cols = matrix[0].length;
        let coversCorner = false;
        let sharesDiagonal = false;
        let sharesEdge = false;
        const cornerTarget = startingCorners[player];

        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                if (matrix[r][c] !== 1) continue;
                const bx = startX + c;
                const by = startY + r;

                // Out of bounds check
                if (bx < 0 || bx >= BOARD_SIZE || by < 0 || by >= BOARD_SIZE) {
                    return { valid: false, reason: 'Tile extends beyond the board.' };
                }

                // Collision check
                if (gridData[by][bx] !== null) {
                    return { valid: false, reason: 'Tile overlaps an occupied square.' };
                }

                // Trust Immunity Enforcement (Open Book Card)
                // Opponents cannot place tiles adjacent to immune player's corner matrix
                if (trustImmunity.stepsRemaining > 0 && trustImmunity.player && trustImmunity.player !== player) {
                    const immunePlayer = trustImmunity.player;
                    const surrounding = [
                        { x: bx + 1, y: by }, { x: bx - 1, y: by },
                        { x: bx, y: by + 1 }, { x: bx, y: by - 1 },
                        { x: bx + 1, y: by + 1 }, { x: bx - 1, y: by + 1 },
                        { x: bx + 1, y: by - 1 }, { x: bx - 1, y: by - 1 }
                    ];
                    for (const s of surrounding) {
                        if (s.x >= 0 && s.x < BOARD_SIZE && s.y >= 0 && s.y < BOARD_SIZE) {
                            if (gridData[s.y][s.x] === immunePlayer) {
                                return {
                                    valid: false,
                                    reason: `Blocked by ${playerNames[immunePlayer]}'s Trust Immunity (${trustImmunity.stepsRemaining} steps remaining).`
                                };
                            }
                        }
                    }
                }

                // First placement check: must cover designated starting corner
                if (firstMoveTracker[player]) {
                    if (bx === cornerTarget.x && by === cornerTarget.y) {
                        coversCorner = true;
                    }
                } else {
                    // Check edges (Forbidden if sharing edge with own color)
                    const edges = [
                        { x: bx + 1, y: by },
                        { x: bx - 1, y: by },
                        { x: bx, y: by + 1 },
                        { x: bx, y: by - 1 }
                    ];
                    for (const e of edges) {
                        if (e.x >= 0 && e.x < BOARD_SIZE && e.y >= 0 && e.y < BOARD_SIZE) {
                            if (gridData[e.y][e.x] === player) {
                                sharesEdge = true;
                            }
                        }
                    }

                    // Check diagonals (Must share corner with own color or neutral bridge)
                    const diags = [
                        { x: bx + 1, y: by + 1 },
                        { x: bx - 1, y: by + 1 },
                        { x: bx + 1, y: by - 1 },
                        { x: bx - 1, y: by - 1 }
                    ];
                    for (const d of diags) {
                        if (d.x >= 0 && d.x < BOARD_SIZE && d.y >= 0 && d.y < BOARD_SIZE) {
                            const val = gridData[d.y][d.x];
                            if (val === player || val === 'neutral-bridge') {
                                sharesDiagonal = true;
                            }
                        }
                    }
                }
            }
        }

        if (firstMoveTracker[player]) {
            if (!coversCorner) {
                return { valid: false, reason: `First move must cover your starting corner (${cornerTarget.x}, ${cornerTarget.y}).` };
            }
            return { valid: true };
        }

        if (sharesEdge) {
            return { valid: false, reason: 'Cannot touch flat edges with your own color tiles.' };
        }
        if (!sharesDiagonal) {
            return { valid: false, reason: 'Must touch at least one diagonal corner of your own color or a neutral bridge.' };
        }

        return { valid: true };
    }

    // Hover Highlight Feedback (Mathematical Cell Tracking, Zero Jitter)
    function highlightHover(x, y) {
        clearHover();
        hoveredOrigin = { x, y };

        if (pendingCardAction === 'place_wall' || pendingCardAction === 'place_bridge') {
            const cell = document.getElementById(`cell-${x}-${y}`);
            if (cell && gridData[y][x] === null) {
                cell.classList.add('legal-highlight');
            } else if (cell) {
                cell.classList.add('illegal-highlight');
            }
            return;
        }

        if (pendingCardAction) {
            // During flood-fill card selection, hover indicates candidate square
            const cell = document.getElementById(`cell-${x}-${y}`);
            if (cell) cell.style.filter = 'brightness(1.15)';
            return;
        }

        const rows = currentMatrix.length;
        const cols = currentMatrix[0].length;
        const validation = validatePlacement(currentMatrix, x, y, currentTurn);

        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                if (currentMatrix[r][c] !== 1) continue;
                const bx = x + c;
                const by = y + r;
                if (bx >= 0 && bx < BOARD_SIZE && by >= 0 && by < BOARD_SIZE) {
                    const cell = document.getElementById(`cell-${bx}-${by}`);
                    if (cell) {
                        cell.classList.add(validation.valid ? 'legal-highlight' : 'illegal-highlight');
                    }
                }
            }
        }
    }

    function clearHover() {
        const highlighted = document.querySelectorAll('.legal-highlight, .illegal-highlight');
        highlighted.forEach(el => {
            el.classList.remove('legal-highlight');
            el.classList.remove('illegal-highlight');
            el.style.filter = '';
        });
    }

    // Board Cell Click Dispatcher
    function handleCellClick(x, y) {
        // --- POWER CARD ACTION: BOUNDARY WALL ---
        if (pendingCardAction === 'place_wall') {
            if (gridData[y][x] !== null) {
                showToast("Cannot build boundary wall on an occupied cell!");
                playBeep(240, 'sawtooth', 0.2);
                return;
            }
            // Finalized: consume card & apply penalty
            gridData[y][x] = 'neutral-wall';
            consumeCard(currentTurn, 'wall');
            circumscribingPenalty[currentTurn] = true;
            pendingCardAction = null;
            hideCancelBtn();

            logAction(`🧱 <strong>${playerNames[currentTurn]}</strong> built a neutral Boundary Wall at (${x}, ${y}). Circumscribing Penalty triggered (skips next turn).`);
            playBeep(320, 'sine', 0.25);
            showToast("Boundary Wall placed! Circumscribing Penalty applied.");
            renderBoardState();
            advanceTurn();
            return;
        }

        // --- POWER CARD ACTION: THIRD-PARTY BRIDGE ---
        if (pendingCardAction === 'place_bridge') {
            if (gridData[y][x] !== null) {
                showToast("Cannot place bridge on an occupied square!");
                playBeep(240, 'sawtooth', 0.2);
                return;
            }
            // Finalized: consume card
            gridData[y][x] = 'neutral-bridge';
            consumeCard(currentTurn, 'bridge');
            pendingCardAction = null;
            hideCancelBtn();

            logAction(`🌉 <strong>${playerNames[currentTurn]}</strong> built a collaborative Third-Party Bridge at (${x}, ${y})!`);
            playBeep(640, 'sine', 0.3);
            showToast("Third-Party Bridge constructed! Overrides adjacency for all players.");
            renderBoardState();
            advanceTurn();
            return;
        }

        // --- POWER CARD ACTION: SWAP - SELECT PROPOSER'S OWN BLOCK ---
        if (pendingCardAction === 'swap_pick_proposer') {
            if (gridData[y][x] !== currentTurn) {
                showToast(`Must click a tile block of your own color (${currentTurn.toUpperCase()})!`);
                playBeep(240, 'sawtooth', 0.2);
                return;
            }
            // Flood-Fill calculates whole structure
            swapProposerCoords = floodFillBlock(x, y, currentTurn);
            renderBoardState();
            playBeep(700, 'sine', 0.15);
            
            pendingCardAction = 'swap_pick_target';
            document.getElementById('action-prompt').innerText = `Step 2/3: Click an opponent tile block (${swapTargetPlayer.toUpperCase()}) to trade with.`;
            showToast(`Selected your ${swapProposerCoords.length}-square block (solid purple). Now click opponent block.`);
            return;
        }

        // --- POWER CARD ACTION: SWAP - SELECT TARGET OPPONENT'S BLOCK ---
        if (pendingCardAction === 'swap_pick_target') {
            if (gridData[y][x] !== swapTargetPlayer) {
                showToast(`Must click a tile block of ${playerNames[swapTargetPlayer]}'s color (${swapTargetPlayer.toUpperCase()})!`);
                playBeep(240, 'sawtooth', 0.2);
                return;
            }
            // Flood-Fill calculates whole structure
            swapTargetCoords = floodFillBlock(x, y, swapTargetPlayer);
            renderBoardState();
            playBeep(800, 'sine', 0.15);

            // Step 3: Trigger A / B Consensus Prompt Review Modal
            triggerSwapConsensusModal();
            return;
        }

        // --- POWER CARD ACTION: FORCE KEEP - SELECT OPPONENT BLOCK ---
        if (pendingCardAction === 'force_keep_pick') {
            const cellOwner = gridData[y][x];
            if (!cellOwner || cellOwner === currentTurn || cellOwner === 'neutral-wall' || cellOwner === 'neutral-bridge') {
                showToast("Must click an opponent's tile cluster!");
                playBeep(240, 'sawtooth', 0.2);
                return;
            }
            // Recursive Flood-Fill to find entire block
            forceKeepSelectedCoords = floodFillBlock(x, y, cellOwner);
            renderBoardState();
            playBeep(650, 'triangle', 0.2);

            triggerForceKeepModal(cellOwner);
            return;
        }

        // --- STANDARD TILE PLACEMENT ---
        const validation = validatePlacement(currentMatrix, x, y, currentTurn);
        if (!validation.valid) {
            showToast(validation.reason);
            playBeep(200, 'sawtooth', 0.15);
            return;
        }

        // Commit placement
        const rows = currentMatrix.length;
        const cols = currentMatrix[0].length;
        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                if (currentMatrix[r][c] === 1) {
                    gridData[y + r][x + c] = currentTurn;
                }
            }
        }

        // Remove piece from player inventory
        const inv = playerInventories[currentTurn];
        const pieceIdx = inv.indexOf(selectedPieceId);
        if (pieceIdx > -1) {
            inv.splice(pieceIdx, 1);
        }
        firstMoveTracker[currentTurn] = false;

        logAction(`🟢 <strong>${playerNames[currentTurn]}</strong> placed <em>${selectedPieceId}</em> at (${x}, ${y}).`);
        playBeep(720, 'triangle', 0.14);
        renderBoardState();
        clearHover();

        if (checkGameEnd()) {
            triggerVictory();
            return;
        }

        advanceTurn();
    }

    // Turn Management & Step Countdown
    function advanceTurn() {
        // Step countdown for Trust Immunity (8 steps = 2 full rounds)
        if (trustImmunity.stepsRemaining > 0) {
            trustImmunity.stepsRemaining--;
            if (trustImmunity.stepsRemaining === 0) {
                logAction(`🛡️ Trust Immunity for <strong>${playerNames[trustImmunity.player]}</strong> has expired.`);
                trustImmunity.player = null;
            }
        }

        const currIdx = players.indexOf(currentTurn);
        currentTurn = players[(currIdx + 1) % players.length];

        // Circumscribing Penalty Check (Skip Turn Step)
        if (circumscribingPenalty[currentTurn]) {
            circumscribingPenalty[currentTurn] = false;
            logAction(`⚠️ <strong>${playerNames[currentTurn]}</strong> skipped turn due to Circumscribing Penalty (Boundary Wall).`);
            showToast(`${playerNames[currentTurn]} turn skipped (Circumscribing Penalty).`);
            playBeep(300, 'sine', 0.15);
            advanceTurn();
            return;
        }

        // Auto-select first available piece
        const inv = playerInventories[currentTurn];
        if (inv.length > 0) {
            selectPiece(inv[0]);
        }

        updateUI();
    }

    function passTurn() {
        if (pendingCardAction) {
            cancelPendingCardAction();
            return;
        }
        logAction(`⏸️ <strong>${playerNames[currentTurn]}</strong> passed their turn.`);
        playBeep(350, 'sine', 0.12);
        showToast(`${playerNames[currentTurn]} passed.`);
        advanceTurn();
    }

    function selectPiece(id) {
        selectedPieceId = id;
        const piece = getPieceDefinition(id);
        currentMatrix = piece.matrix;
        renderActivePiecePreview();
        renderPiecesTray();
    }

    function renderActivePiecePreview() {
        const piece = getPieceDefinition(selectedPieceId);
        document.getElementById('active-tile-name').innerText = `${piece.name} (${selectedPieceId}, ${piece.size} sq)`;
        const container = document.getElementById('active-tile-matrix');
        container.innerHTML = '';
        container.style.gridTemplateColumns = `repeat(${currentMatrix[0].length}, 16px)`;

        for (let r = 0; r < currentMatrix.length; r++) {
            for (let c = 0; c < currentMatrix[0].length; c++) {
                const sq = document.createElement('div');
                sq.className = 'p-square';
                if (currentMatrix[r][c] === 1) {
                    sq.classList.add('filled');
                    sq.style.backgroundColor = playerColorsHex[currentTurn];
                }
                container.appendChild(sq);
            }
        }
    }

    function renderPiecesTray() {
        const tray = document.getElementById('pieces-tray');
        tray.innerHTML = '';
        const inv = playerInventories[currentTurn];
        document.getElementById('tray-count-label').innerText = `${inv.length} tiles remaining`;

        BLOKUS_PIECES.forEach(piece => {
            const isAvailable = inv.includes(piece.id);
            const item = document.createElement('div');
            item.className = 'tray-item';
            if (piece.id === selectedPieceId) item.classList.add('active');
            if (!isAvailable) item.classList.add('used');

            // Miniature matrix
            const mini = document.createElement('div');
            mini.className = 'piece-matrix-view';
            mini.style.gridTemplateColumns = `repeat(${piece.matrix[0].length}, 8px)`;
            for (let r = 0; r < piece.matrix.length; r++) {
                for (let c = 0; c < piece.matrix[0].length; c++) {
                    const sq = document.createElement('div');
                    sq.style.width = '8px';
                    sq.style.height = '8px';
                    sq.style.background = piece.matrix[r][c] === 1 ? playerColorsHex[currentTurn] : 'transparent';
                    mini.appendChild(sq);
                }
            }
            item.appendChild(mini);

            const label = document.createElement('div');
            label.className = 'tray-item-label';
            label.innerText = piece.id;
            item.appendChild(label);

            if (isAvailable) {
                item.addEventListener('click', () => {
                    selectPiece(piece.id);
                    playBeep(580, 'sine', 0.08);
                });
            }

            tray.appendChild(item);
        });
    }

    function updateUI() {
        // Turn indicator
        const turnHeader = document.getElementById('turn-indicator');
        turnHeader.innerText = `Current Turn: ${playerNames[currentTurn]} (${currentTurn.toUpperCase()})`;
        turnHeader.style.color = playerColorsHex[currentTurn];

        const prompt = document.getElementById('action-prompt');
        if (pendingCardAction) {
            // Card prompt active
        } else if (firstMoveTracker[currentTurn]) {
            prompt.innerText = `First Move: Must anchor your piece on corner (${startingCorners[currentTurn].x}, ${startingCorners[currentTurn].y})!`;
        } else {
            prompt.innerText = 'Position tile to touch your diagonal corners without flat edge contact.';
        }

        // Status Pills
        const pillsRow = document.getElementById('status-pills-row');
        pillsRow.innerHTML = '';
        if (trustImmunity.stepsRemaining > 0 && trustImmunity.player) {
            const pill = document.createElement('span');
            pill.className = 'status-pill immunity';
            pill.innerHTML = `🛡️ Trust Immunity: ${playerNames[trustImmunity.player]} (${trustImmunity.stepsRemaining} steps left)`;
            pillsRow.appendChild(pill);
        }
        if (circumscribingPenalty[currentTurn]) {
            const pill = document.createElement('span');
            pill.className = 'status-pill penalty';
            pill.innerHTML = `⚠️ Circumscribing Penalty (Next turn will be skipped)`;
            pillsRow.appendChild(pill);
        }

        // Deck Moves Remaining (Strict Cap 3)
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        const movesBadge = document.getElementById('deck-moves-left-badge');
        movesBadge.innerText = `Moves Left: ${movesLeft} / ${MAX_POWER_MOVES}`;
        if (movesLeft <= 0) {
            movesBadge.style.background = '#fee2e2';
            movesBadge.style.color = '#b91c1c';
        } else {
            movesBadge.style.background = '#f3e8ff';
            movesBadge.style.color = '#7e22ce';
        }

        // Power Deck Button States (Conditional balance + deck cap)
        const deck = playerDecks[currentTurn];
        const hasMoves = movesLeft > 0;

        document.getElementById('count-swap').innerText = deck.swap;
        document.getElementById('card-swap').disabled = !hasMoves || deck.swap <= 0;

        document.getElementById('count-force').innerText = deck.force;
        document.getElementById('card-force').disabled = !hasMoves || deck.force <= 0;

        document.getElementById('count-open').innerText = deck.open;
        document.getElementById('card-open').disabled = !hasMoves || deck.open <= 0;

        document.getElementById('count-wall').innerText = deck.wall;
        document.getElementById('card-wall').disabled = !hasMoves || deck.wall <= 0;

        document.getElementById('count-bridge').innerText = deck.bridge;
        document.getElementById('card-bridge').disabled = !hasMoves || deck.bridge <= 0;

        // Roster Render with Politeness Token Score Engine
        const roster = document.getElementById('roster-grid');
        roster.innerHTML = '';
        players.forEach(p => {
            const card = document.createElement('div');
            card.className = 'roster-card';
            if (p === currentTurn) card.classList.add('active-turn');

            const remainingSquares = playerInventories[p].reduce((acc, pid) => acc + getPieceDefinition(pid).size, 0);
            const tokens = politenessTokens[p];
            const netPenalty = Math.max(0, remainingSquares - (tokens * 3));

            card.innerHTML = `
                <div class="roster-header">
                    <span class="color-dot" style="background: ${playerColorsHex[p]};"></span>
                    <span>${playerNames[p]}</span>
                </div>
                <div class="roster-stats">
                    <span>Tiles: <strong>${playerInventories[p].length}</strong></span>
                    <span>Net Penalty: <strong>${netPenalty}</strong></span>
                    <span class="token-tag">Tokens: <strong>${tokens}</strong> (-${tokens * 3})</span>
                </div>
            `;
            roster.appendChild(card);
        });

        renderPiecesTray();
        renderActivePiecePreview();
    }

    // Modal Control
    function openModal(contentHtml) {
        const modal = document.getElementById('workflow-modal');
        const wrapper = document.getElementById('modal-wrapper');
        wrapper.innerHTML = contentHtml;
        modal.style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('workflow-modal').style.display = 'none';
    }

    function showCancelBtn() {
        document.getElementById('cancel-action-btn').style.display = 'inline-flex';
    }

    function hideCancelBtn() {
        document.getElementById('cancel-action-btn').style.display = 'none';
    }

    // Conditional Card Consumption Utility
    function consumeCard(player, cardKey) {
        playerDecks[player][cardKey]--;
        powerMovesUsed[player]++;
        updateUI();
    }

    function cancelPendingCardAction() {
        pendingCardAction = null;
        swapProposerCoords = [];
        swapTargetCoords = [];
        swapTargetPlayer = null;
        forceKeepSelectedCoords = [];
        hideCancelBtn();
        renderBoardState();
        updateUI();
        showToast("Power Card action cancelled. Inventory balance preserved!");
        playBeep(320, 'sine', 0.1);
    }

    /* =========================================================================
       POWER CARD 1: SWAP CARD (MUTUAL FLOOD-FILL & HOST ARBITRATION)
       ========================================================================= */
    function initiateSwapWorkflow() {
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        if (movesLeft <= 0 || playerDecks[currentTurn].swap <= 0) return;

        // Step 1: Target Designation Trigger
        const otherPlayers = players.filter(p => p !== currentTurn);
        let optionsHtml = otherPlayers.map(p => `
            <option value="${p}">${playerNames[p]} (${p.toUpperCase()})</option>
        `).join('');

        openModal(`
            <h3 style="margin-top:0;">🔄 Initiate Swap Card</h3>
            <p style="font-size:0.9rem; color:#64748b;">
                Select target opponent. You will each designate one contiguous tile block on the board via mathematical Flood-Fill to trade.
            </p>
            <div style="margin: 15px 0;">
                <label style="font-weight:600; display:block; margin-bottom:6px;">Designate Target Opponent:</label>
                <select id="swap-target-player" class="select-input">
                    ${optionsHtml}
                </select>
            </div>
            <div class="modal-actions">
                <button class="btn btn-confirm" onclick="confirmSwapTarget()">Proceed to Mutual Selection ➔</button>
                <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
            </div>
        `);
    }

    function confirmSwapTarget() {
        swapTargetPlayer = document.getElementById('swap-target-player').value;
        closeModal();

        pendingCardAction = 'swap_pick_proposer';
        swapProposerCoords = [];
        swapTargetCoords = [];
        showCancelBtn();

        document.getElementById('action-prompt').innerText = `Step 1/3: Click your own tile block (${currentTurn.toUpperCase()}) on the board to highlight in Purple.`;
        showToast(`Target set: ${playerNames[swapTargetPlayer]}. Click your own block.`);
    }

    function triggerSwapConsensusModal() {
        // Step 3: A / B Consensus Prompt Review Modal
        openModal(`
            <h3 style="margin-top:0;">🤝 A / B Consensus Prompt</h3>
            <p style="font-size:0.92rem; line-height:1.4;">
                <strong>${playerNames[currentTurn]}</strong> proposes swapping their <strong>${swapProposerCoords.length}-square</strong> block (<span style="color:#9b59b6; font-weight:700;">Purple</span>) for <strong>${playerNames[swapTargetPlayer]}</strong>'s <strong>${swapTargetCoords.length}-square</strong> block (<span style="color:#00bcd4; font-weight:700;">Cyan</span>).
            </p>
            <div style="background:#ecfdf5; border:1px solid #a7f3d0; padding:12px; border-radius:8px; margin:14px 0; font-size:0.85rem; color:#065f46;">
                🌟 <strong>Consensus Reward:</strong> If accepted, both players receive <strong>+1 Politeness Token (-3 penalty deduction)</strong>.
            </div>
            <div class="modal-actions">
                <button class="btn btn-confirm" onclick="resolveSwapConsensus(true)">Accept & Save Face (Mutual Benefit)</button>
                <button class="btn btn-reject" onclick="resolveSwapConsensus(false)">Decline Trade</button>
            </div>
        `);
    }

    function resolveSwapConsensus(accepted) {
        closeModal();
        if (accepted) {
            // Approved: execute swap & consume card & grant politeness tokens
            executeApprovedSwap();
        } else {
            // Declined: invoke Host Arbitration
            triggerHostArbitrationModal();
        }
    }

    function executeApprovedSwap() {
        // Execute ownership swap in matrix
        swapProposerCoords.forEach(c => {
            gridData[c.y][c.x] = swapTargetPlayer;
        });
        swapTargetCoords.forEach(c => {
            gridData[c.y][c.x] = currentTurn;
        });

        // Politeness Token Reward (-3 penalty deduction each)
        politenessTokens[currentTurn]++;
        politenessTokens[swapTargetPlayer]++;

        // Consume card only on finalized approval
        consumeCard(currentTurn, 'swap');

        logAction(`🤝 <strong>Consensus Achieved!</strong> ${playerNames[currentTurn]} and ${playerNames[swapTargetPlayer]} swapped blocks. Both gained +1 Politeness Token (-3 penalty)!`);
        playBeep(880, 'sine', 0.35);
        showToast("Mutual trade finalized! +1 Politeness Token to both.");

        // Clean up state
        pendingCardAction = null;
        swapProposerCoords = [];
        swapTargetCoords = [];
        swapTargetPlayer = null;
        hideCancelBtn();
        renderBoardState();
        updateUI();
        advanceTurn();
    }

    function triggerHostArbitrationModal() {
        openModal(`
            <h3 style="margin-top:0; color:#8e44ad;">⚖️ Host Arbitration Invoked</h3>
            <p style="font-size:0.9rem; color:#64748b;">
                <strong>${playerNames[swapTargetPlayer]}</strong> declined the proposed trade. As session host, choose the final ruling:
            </p>
            <div class="modal-actions">
                <button class="btn btn-arbitrate" onclick="hostEnforceSwap()">Host Enforces Swap</button>
                <button class="btn btn-secondary" onclick="hostRefundSwap()">Cancel & Refund Card</button>
            </div>
        `);
    }

    function hostEnforceSwap() {
        closeModal();
        logAction(`⚖️ <strong>Host Ruling:</strong> Host enforced the tile swap between ${playerNames[currentTurn]} and ${playerNames[swapTargetPlayer]}.`);
        executeApprovedSwap();
    }

    function hostRefundSwap() {
        closeModal();
        cancelPendingCardAction();
        logAction(`⚖️ <strong>Host Ruling:</strong> Trade cancelled. ${playerNames[currentTurn]}'s Swap Card balance refunded.`);
        showToast("Trade cancelled. Card refunded.");
        playBeep(300, 'sine', 0.15);
    }

    /* =========================================================================
       POWER CARD 2: FORCE KEEP CARD (FLOOD-FILL HIJACK)
       ========================================================================= */
    function activateForceKeepCard() {
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        if (movesLeft <= 0 || playerDecks[currentTurn].force <= 0) return;

        pendingCardAction = 'force_keep_pick';
        forceKeepSelectedCoords = [];
        showCancelBtn();

        document.getElementById('action-prompt').innerText = "Click any opponent's tile cluster on the board to hijack ownership via Flood-Fill.";
        showToast("Force Keep active: Click an opponent's tile cluster.");
        playBeep(520, 'square', 0.15);
    }

    function triggerForceKeepModal(victimPlayer) {
        openModal(`
            <h3 style="margin-top:0; color:#d35400;">🎯 Confirm Force Keep Hijack</h3>
            <p style="font-size:0.92rem; line-height:1.4;">
                Hijack the entire <strong>${forceKeepSelectedCoords.length}-square</strong> cluster of <strong>${playerNames[victimPlayer]}</strong> (<span style="color:#e67e22; font-weight:700;">Highlighted Orange</span>) to your ownership?
            </p>
            <div class="modal-actions">
                <button class="btn btn-confirm" onclick="confirmForceKeep('${victimPlayer}')">Lock & Hijack Ownership</button>
                <button class="btn btn-secondary" onclick="cancelPendingCardAction(); closeModal();">Cancel & Refund</button>
            </div>
        `);
    }

    function confirmForceKeep(victimPlayer) {
        closeModal();
        // Hijack structural ownership to active player
        forceKeepSelectedCoords.forEach(c => {
            gridData[c.y][c.x] = currentTurn;
        });

        // Finalized: consume card
        consumeCard(currentTurn, 'force');
        logAction(`🎯 <strong>${playerNames[currentTurn]}</strong> activated Force Keep: hijacked ${forceKeepSelectedCoords.length}-square cluster from ${playerNames[victimPlayer]}.`);
        playBeep(750, 'triangle', 0.3);
        showToast("Cluster hijacked and secured!");

        pendingCardAction = null;
        forceKeepSelectedCoords = [];
        hideCancelBtn();
        renderBoardState();
        advanceTurn();
    }

    /* =========================================================================
       POWER CARD 3: OPEN BOOK CARD (TRUST IMMUNITY - 2 ROUNDS / 8 STEPS)
       ========================================================================= */
    function activateOpenBookCard() {
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        if (movesLeft <= 0 || playerDecks[currentTurn].open <= 0) return;

        // Reveal remaining opponent reserves face-up
        const otherPlayers = players.filter(p => p !== currentTurn);
        let listHtml = otherPlayers.map(p => {
            const tiles = playerInventories[p].map(tid => `<strong>${tid}</strong> (${getPieceDefinition(tid).size}sq)`).join(', ');
            return `
                <div style="background:#f8fafc; border:1px solid #e2e8f0; padding:10px; border-radius:6px; margin-bottom:8px; text-align:left;">
                    <div style="font-weight:700; color:${playerColorsHex[p]};">${playerNames[p]} (${p.toUpperCase()})</div>
                    <div style="font-size:0.8rem; color:#475569; margin-top:4px;">Remaining Hand (${playerInventories[p].length} tiles): ${tiles || 'Empty'}</div>
                </div>
            `;
        }).join('');

        openModal(`
            <h3 style="margin-top:0; color:#2980b9;">📖 Open Book — Social Penetration Intelligence</h3>
            <p style="font-size:0.85rem; color:#64748b;">
                Transparently review all opponent reserves to assess mutual vulnerabilities. Grants <strong>Trust Immunity</strong> for 2 full rounds (8 individual steps) preventing opponent placements adjacent to your matrix!
            </p>
            <div style="max-height:220px; overflow-y:auto; margin:14px 0;">
                ${listHtml}
            </div>
            <div class="modal-actions">
                <button class="btn btn-confirm" onclick="confirmOpenBookActivation()">Activate Trust Immunity (8 Steps)</button>
                <button class="btn btn-secondary" onclick="closeModal()">Cancel & Refund</button>
            </div>
        `);
    }

    function confirmOpenBookActivation() {
        closeModal();
        // Consume card
        consumeCard(currentTurn, 'open');

        // Grant Trust Immunity for 2 full rounds (8 individual steps)
        trustImmunity = {
            player: currentTurn,
            stepsRemaining: 8
        };

        logAction(`📖 <strong>${playerNames[currentTurn]}</strong> deployed Open Book Card. Gained <strong>Trust Immunity</strong> for 2 full rounds (8 steps)!`);
        playBeep(620, 'sine', 0.25);
        showToast(`Trust Immunity active for 8 steps! Opponents cannot build adjacent to your tiles.`);
        updateUI();
    }

    /* =========================================================================
       POWER CARD 4: BOUNDARY WALL (CIRCUMSCRIBING PENALTY)
       ========================================================================= */
    function activateBoundaryWallCard() {
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        if (movesLeft <= 0 || playerDecks[currentTurn].wall <= 0) return;

        pendingCardAction = 'place_wall';
        showCancelBtn();

        document.getElementById('action-prompt').innerText = "Click any empty board square to build a neutral grey Boundary Wall (#7f8c8d).";
        showToast("Boundary Wall: Click any empty cell to place barricade.");
        playBeep(400, 'sine', 0.12);
    }

    /* =========================================================================
       POWER CARD 5: THIRD-PARTY BRIDGE (COLLABORATIVE DIAGONAL)
       ========================================================================= */
    function activateThirdPartyBridge() {
        const movesLeft = MAX_POWER_MOVES - powerMovesUsed[currentTurn];
        if (movesLeft <= 0 || playerDecks[currentTurn].bridge <= 0) return;

        pendingCardAction = 'place_bridge';
        showCancelBtn();

        document.getElementById('action-prompt').innerText = "Click any empty bottleneck slot to build a collaborative Third-Party Bridge (#16a085).";
        showToast("Third-Party Bridge: Click any empty cell to construct bridge.");
        playBeep(600, 'sine', 0.12);
    }

    /* =========================================================================
       POLITENESS TOKEN SCORING ENGINE & END-GAME CALCULATION
       ========================================================================= */
    function checkGameEnd() {
        return players.every(p => playerInventories[p].length === 0);
    }

    function triggerVictory() {
        // Routine: Total Penalty Score = (Unplaced remaining tile squares) - (Politeness Tokens * 3)
        let scores = players.map(p => {
            const unplacedSquares = playerInventories[p].reduce((acc, pid) => acc + getPieceDefinition(pid).size, 0);
            const tokens = politenessTokens[p];
            const tokenDeduction = tokens * 3;
            const finalPenalty = Math.max(0, unplacedSquares - tokenDeduction);
            return {
                player: p,
                name: playerNames[p],
                unplacedSquares,
                tokens,
                tokenDeduction,
                finalPenalty
            };
        });

        // Enforcement Rule: Lowest penalty score wins
        scores.sort((a, b) => a.finalPenalty - b.finalPenalty);
        const winner = scores[0];

        let resultsTable = scores.map((s, idx) => `
            <tr style="border-bottom:1px solid #e2e8f0;">
                <td style="padding:8px; font-weight:700;">#${idx + 1}</td>
                <td style="padding:8px; color:${playerColorsHex[s.player]}; font-weight:700;">${s.name}</td>
                <td style="padding:8px;">${s.unplacedSquares} sq</td>
                <td style="padding:8px; color:#059669; font-weight:700;">-${s.tokenDeduction} pts (${s.tokens} tokens)</td>
                <td style="padding:8px; font-weight:800; font-size:1.15rem; color:#1e293b;">${s.finalPenalty}</td>
            </tr>
        `).join('');

        openModal(`
            <h2 style="margin-top:0; color:#059669;">🏆 Game Complete — Consensus Achieved!</h2>
            <p><strong>${winner.name}</strong> claims victory with the lowest penalty score of <strong>${winner.finalPenalty}</strong>!</p>
            <table style="width:100%; border-collapse:collapse; margin:15px 0; font-size:0.9rem;">
                <thead>
                    <tr style="background:#f8fafc; border-bottom:2px solid #cbd5e1; text-align:left;">
                        <th style="padding:8px;">Rank</th>
                        <th style="padding:8px;">Player Profile</th>
                        <th style="padding:8px;">Unplaced</th>
                        <th style="padding:8px;">Politeness Bonus</th>
                        <th style="padding:8px;">Final Penalty</th>
                    </tr>
                </thead>
                <tbody>
                    ${resultsTable}
                </tbody>
            </table>
            <div style="font-size:0.8rem; color:#64748b; background:#f8fafc; padding:8px 12px; border-radius:6px; margin-bottom:12px;">
                💡 <em>Mathematically rewarding collaborative trades, consensus, and face-saving options.</em>
            </div>
            <div class="modal-actions">
                <button class="btn btn-confirm" onclick="location.reload()">Play Again</button>
            </div>
        `);

        playBeep(880, 'sine', 0.6);
    }

    // Keyboard Shortcuts (R to Rotate, F to Flip, P to Pass)
    window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
        if (e.key === 'r' || e.key === 'R') {
            rotateCurrentTile();
        } else if (e.key === 'f' || e.key === 'F') {
            flipCurrentTile();
        } else if (e.key === 'p' || e.key === 'P') {
            passTurn();
        }
    });

    // Boot: Initialize URL room parameter query string
    window.addEventListener('DOMContentLoaded', () => {
        initRoomParameter();
    });
</script>

