    // Matrix Transformations
    function rotateMatrix(mat) {
        const rows = mat.length;
        const cols = mat[0].length;
        const rotated = [];
        for (let c = 0; c < cols; c++) {
            const newRow = [];
            for (let r = rows - 1; r >= 0; r--) {
                newRow.push(mat[r][c]);
            }
            rotated.push(newRow);
        }
        return rotated;
    }

    function flipMatrix(mat) {
        return mat.map(row => [...row].reverse());
    }

