  const tileBLabel = pieceB ? pieceB.name : 'Tile B';

  const handleConfirm = () => {
    if (!pieceA || !pieceB || !targetPlayerId) return;
    onConfirmExchange(targetPlayerId, pieceA.id, pieceB.id);
